# 复制成 deploy/app.env 再填。**绝不提交进 git**（.gitignore 已经挡了）
#
# 数据平台的机器人账号。凭证只有这一个来源 —— 绝不接受调用方传入，
# 那样会进流程定义、进日志、进 git
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_USERNAME=
OAUTH_PASSWORD=

# worker 以"这一版的发布者"的名义调数据平台时，用它证明自己是 worker。
# api 和 worker 两个容器必须配成同一个值；不配的话定时任务一律退回机器人账号
# 的权限（fail closed —— 宁可少一层隔离，也不留一个加个头就能冒充的口子）。
# 生成：openssl rand -hex 32
WORKER_TOKEN=

# http.request 节点的出网白名单（留空 = 拦内网、放行公网）
# HTTP_NODE_ALLOWED_HOSTS=qyapi.weixin.qq.com internal.corp
# k8s 用了 100.64/10 之类的话在这里追加
# HTTP_NODE_BLOCKED_CIDRS=100.64.0.0/10
